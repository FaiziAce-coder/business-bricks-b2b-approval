{% layout 'theme' %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Semi-Custom Sets — {{ shop.name }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <style>
  :root {
    --purple:     #8B2FE0;
    --purple-g:   linear-gradient(135deg,#9B3FEF,#7B28CC);
    --black:      #08080D;
    --navy:       #0E0E1C;
    --card-bg:    #111120;
    --border:     rgba(255,255,255,0.08);
    --border-h:   rgba(139,47,224,0.50);
    --text:       #FFFFFF;
    --muted:      rgba(255,255,255,0.50);
    --subtle:     rgba(255,255,255,0.25);
  }
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    font-family:'Inter',sans-serif;
    background:var(--black);
    color:var(--text);
    overflow-x:hidden;
  }
  body::before{
    content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
    background:
      radial-gradient(ellipse 60% 50% at 8% 5%,rgba(139,47,224,.15) 0%,transparent 58%),
      radial-gradient(ellipse 50% 45% at 92% 92%,rgba(75,16,128,.17) 0%,transparent 58%);
  }
  .page{position:relative;z-index:1}

    .hero{
    background:linear-gradient(120deg,#0C0C22 0%,#0E0E28 55%,#0A0820 100%);
    min-height:420px;
    display:grid;grid-template-columns:1.2fr 0.8fr;
    position:relative;overflow:hidden;
  }
  .hero::before{
    content:'';position:absolute;inset:0;
    background:
      radial-gradient(ellipse 55% 70% at 15% 50%,rgba(139,47,224,.22) 0%,transparent 60%),
      radial-gradient(ellipse 45% 45% at 80% 30%,rgba(34,211,238,.06) 0%,transparent 55%);
  }
  .hero-l{
    padding:70px 60px 60px;
    display:flex;flex-direction:column;justify-content:center;
    position:relative;z-index:1;
  }
  .hero-eyebrow{
    font-size:14px;font-weight:700;
    color:var(--purple);font-style:italic;
    margin-bottom:14px;letter-spacing:.2px;
  }
  .hero-l h1{
    font-size:clamp(36px,4.5vw,56px);
    font-weight:900;letter-spacing:-1.5px;line-height:1.08;
    margin-bottom:18px;
  }
  .hero-l p{
    font-size:15px;color:var(--muted);
    line-height:1.7;max-width:520px;margin-bottom:20px;
  }
  .hero-badge-row{
    display:flex;gap:12px;flex-wrap:wrap;
  }
  .hero-badge{
    display:inline-flex;align-items:center;gap:6px;
    background:rgba(139,47,224,0.12);border:1px solid rgba(139,47,224,0.30);
    padding:6px 14px;border-radius:99px;font-size:12px;font-weight:700;color:#C089F8;
  }
  .hero-r{
    position:relative;z-index:1;
    display:flex;align-items:center;justify-content:center;
    padding:30px;
  }
  .hero-r img{
    max-width:380px;width:85%;
    filter:drop-shadow(0 20px 48px rgba(139,47,224,.40));
    animation:float 4s ease-in-out infinite;
  }
  @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
  @media (prefers-reduced-motion: reduce) {
    .hero-r img { animation: none; }
  }

    .catalog-wrap{
    max-width:1280px;margin:0 auto;padding:40px 30px 80px;
  }
  .catalog-toolbar{
    display:flex;align-items:center;justify-content:space-between;
    gap:20px;margin-bottom:32px;flex-wrap:wrap;
  }
  .search-box{
    position:relative;flex:1;min-width:260px;max-width:420px;
  }
  .search-box svg{
    position:absolute;left:16px;top:50%;transform:translateY(-50%);
    stroke:var(--muted);pointer-events:none;
  }
  .search-box input{
    width:100%;height:46px;padding:0 16px 0 44px;
    border-radius:12px;border:1px solid var(--border);
    background:rgba(255,255,255,.04);color:#fff;
    font-family:'Inter',sans-serif;font-size:14px;outline:none;
    transition:border-color .2s;
  }
  .search-box input:focus{border-color:var(--purple)}
  .filter-controls{
    display:flex;align-items:center;gap:12px;flex-wrap:wrap;
  }
  .filter-select{
    height:46px;padding:0 36px 0 16px;
    border-radius:12px;border:1px solid var(--border);
    background:rgba(255,255,255,.04);color:#fff;
    font-family:'Inter',sans-serif;font-size:13px;font-weight:600;
    outline:none;-webkit-appearance:none;appearance:none;cursor:pointer;
    background-image:url("data:image/svg+xml,%3Csvg width='12' height='7' viewBox='0 0 12 7' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L6 6L11 1' stroke='%23C089F8' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat:no-repeat;background-position:right 14px center;
  }
  .filter-select option{background:#111118}
  .catalog-count-pill{
    font-size:13px;font-weight:700;color:var(--muted);
  }

    .product-grid{
    display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));
    gap:24px;
  }
  .prod-card{
    background:var(--card-bg);border:1px solid var(--border);
    border-radius:18px;overflow:hidden;display:flex;flex-direction:column;
    text-decoration:none;color:inherit;transition:transform .2s,border-color .2s,box-shadow .2s;
    position:relative;
  }
  .prod-card:hover{
    transform:translateY(-4px);border-color:var(--border-h);
    box-shadow:0 12px 32px rgba(139,47,224,.22);
  }
  .prod-img-wrap{
    background:rgba(255,255,255,.02);padding:24px;
    aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;
    position:relative;overflow:hidden;
  }
  .prod-img-wrap img{
    width:100%;height:100%;object-fit:contain;
    transition:transform .3s ease;filter:drop-shadow(0 6px 16px rgba(0,0,0,.4));
  }
  .prod-card:hover .prod-img-wrap img{transform:scale(1.05)}
  .prod-body{
    padding:20px;display:flex;flex-direction:column;gap:10px;flex:1;
  }
  .prod-title{
    font-size:16px;font-weight:800;color:#fff;line-height:1.3;
  }
  .prod-meta-tags{
    display:flex;gap:8px;flex-wrap:wrap;
  }
  .prod-brick-tag{
    display:inline-flex;align-items:center;gap:5px;
    font-size:11px;font-weight:700;color:var(--purple);
    background:rgba(139,47,224,0.12);padding:4px 10px;border-radius:6px;
  }
  .prod-brick-tag .brick-icon{
    width:13px;height:13px;fill:currentColor;flex-shrink:0;
  }
  .prod-moq-tag{
    font-size:11px;font-weight:700;color:var(--muted);
    background:rgba(255,255,255,0.06);padding:4px 10px;border-radius:6px;
  }
  .prod-pricing-row{
    display:flex;align-items:baseline;justify-content:space-between;
    margin-top:auto;padding-top:12px;border-top:1px solid rgba(255,255,255,.06);
  }
  .prod-price{
    font-size:16px;font-weight:800;color:#C089F8;
  }
  .prod-action{
    font-size:12px;font-weight:700;color:#fff;
    display:inline-flex;align-items:center;gap:4px;
    background:var(--purple-g);padding:6px 12px;border-radius:8px;
    transition:opacity .2s;
  }
  .prod-card:hover .prod-action{opacity:.9}

    @media(max-width:900px){
    .hero{grid-template-columns:1fr;padding:0}
    .hero-l{padding:40px 24px 20px}
    .hero-r{
      display:flex;
      justify-content:center;
      align-items:center;
      padding:0 24px 32px;
    }
    .hero-r img{
      max-width:300px;
      width:100%;
    }
    .catalog-wrap{padding:30px 20px 60px}
    .product-grid{grid-template-columns:repeat(2,1fr);gap:16px}
  }
  @media(max-width:540px){
    .product-grid{grid-template-columns:1fr;gap:16px}
    .catalog-toolbar{flex-direction:column;align-items:stretch}
    .search-box{max-width:none}
  }
  </style>
  {{ content_for_header }}
</head>
<body>
  <div class="page">
        <section class="hero">
      <div class="hero-l">
        <span class="hero-eyebrow">Customizable Pre-Designed Builds</span>
        <h1>Semi-Custom Sets</h1>
        <p>
          Select from our approved line of pre-designed brick sets. Each set is fully customizable with your company logo, custom packaging, and branded instruction booklets.
        </p>
        <div class="hero-badge-row">
          <span class="hero-badge">
            <svg class="brick-icon" viewBox="0 0 24 24" aria-hidden="true" style="width:13px;height:13px;fill:currentColor;vertical-align:-1px;margin-right:4px;display:inline-block;"><path d="M19 6V5a2 2 0 0 0-2-2h-3V2a1 1 0 0 0-1-1h-2a1 1 0 0 0-1 1v1H7a2 2 0 0 0-2 2v1a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2Zm-7-3h1v1h-1V3ZM7 5h10v1H7V5Zm12 14H5V8h14v11Z"/></svg>MOQ: 250 Units
          </span>
          <span class="hero-badge">📦 Custom Box & Stickers</span>
          <span class="hero-badge">🚚 Standard Shipping Included</span>
        </div>
      </div>
      <div class="hero-r">
        <img src="//promo.businessbricks.com/cdn/shop/files/F1CarRender1V3_700x.png?v=1792763038" alt="Semi-Custom F1 Car Brick Set" width="380" height="285" loading="eager" />
      </div>
    </section>

    {% render 'brand-trust-bar' %}

        <main class="catalog-wrap">
      <div class="catalog-toolbar">
        <div class="search-box">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M11 11L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <input type="text" placeholder="Search semi-custom sets…" oninput="filterProducts()" id="semiCustomSearch"/>
        </div>

        <div class="filter-controls">
          <select class="filter-select" id="sortSelect" onchange="sortProducts()">
            <option value="featured">Featured</option>
            <option value="bricks-low">Bricks: Low to High</option>
            <option value="bricks-high">Bricks: High to Low</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
          </select>
          <span class="catalog-count-pill" id="productCountPill">Showing Products</span>
        </div>
      </div>

      <div class="product-grid" id="semiCustomGrid">
        {% paginate collections.all.products by 250 %}
          {% for product in collections.all.products %}
            {% if product.template_suffix == 'semi-custom-sets' %}
              {% assign brick_count_raw = product.metafields.custom.brick_count.value | default: product.metafields.custom.brick_count %}
              {% assign brick_count = brick_count_raw | plus: 0 %}
              {% assign moq_raw = product.metafields.custom.minimum_order.value | default: product.metafields.custom.minimum_order %}
              {% assign moq_val = moq_raw | plus: 0 %}
              {% if moq_val == 0 %}{% assign moq_val = 250 %}{% endif %}
              <a href="{{ product.url }}" class="prod-card"
                 data-title="{{ product.title | escape | downcase }}"
                 data-bricks="{{ brick_count }}"
                 data-price="{{ product.price }}"
                 data-available="{{ product.available }}">
                <div class="prod-img-wrap">
                  {% if product.featured_image %}
                    <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy"/>
                  {% else %}
                    <div style="display:flex;align-items:center;justify-content:center;opacity:.3"><svg class="brick-icon" style="width:56px;height:56px;fill:var(--purple);" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 6V5a2 2 0 0 0-2-2h-3V2a1 1 0 0 0-1-1h-2a1 1 0 0 0-1 1v1H7a2 2 0 0 0-2 2v1a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2Zm-7-3h1v1h-1V3ZM7 5h10v1H7V5Zm12 14H5V8h14v11Z"/></svg></div>
                  {% endif %}
                </div>
                <div class="prod-body">
                  <h3 class="prod-title">{{ product.title }}</h3>
                  <div class="prod-meta-tags">
                    {% if brick_count > 0 %}
                      <span class="prod-brick-tag">
                        <svg class="brick-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 6V5a2 2 0 0 0-2-2h-3V2a1 1 0 0 0-1-1h-2a1 1 0 0 0-1 1v1H7a2 2 0 0 0-2 2v1a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2Zm-7-3h1v1h-1V3ZM7 5h10v1H7V5Zm12 14H5V8h14v11Z"/></svg>
                        <span>{{ brick_count }} Bricks</span>
                      </span>
                    {% endif %}
                    <span class="prod-moq-tag">MOQ: {{ moq_val }}</span>
                  </div>
                  <div class="prod-pricing-row">
                    <div>
                      <span style="font-size:11px;color:var(--muted);display:block;">Starting at</span>
                      <span class="prod-price">{{ product.price | money }}</span>
                    </div>
                    <span class="prod-action">
                      View Kit
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6h8M6 3l3 3-3 3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </div>
                </div>
              </a>
            {% endif %}
          {% endfor %}
        {% endpaginate %}
      </div>
    </main>
  </div>

  <script>
    function filterProducts() {
      const q = (document.getElementById('semiCustomSearch').value || '').toLowerCase().trim();
      const cards = document.querySelectorAll('#semiCustomGrid .prod-card');
      let visible = 0;
      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        if (!q || title.includes(q)) {
          card.style.display = 'flex';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });
      document.getElementById('productCountPill').innerText = visible + ' Products';
    }

    function sortProducts() {
      const sortBy = document.getElementById('sortSelect').value;
      const grid = document.getElementById('semiCustomGrid');
      const cards = Array.from(grid.querySelectorAll('.prod-card'));

      cards.sort((a, b) => {
        const priceA = parseFloat(a.getAttribute('data-price') || 0);
        const priceB = parseFloat(b.getAttribute('data-price') || 0);
        const bricksA = parseInt(a.getAttribute('data-bricks') || 0, 10);
        const bricksB = parseInt(b.getAttribute('data-bricks') || 0, 10);

        if (sortBy === 'price-low') return priceA - priceB;
        if (sortBy === 'price-high') return priceB - priceA;
        if (sortBy === 'bricks-low') return bricksA - bricksB;
        if (sortBy === 'bricks-high') return bricksB - bricksA;
        return 0;
      });

      cards.forEach(c => grid.appendChild(c));
    }

    document.addEventListener('DOMContentLoaded', () => {
      const cards = document.querySelectorAll('#semiCustomGrid .prod-card');
      document.getElementById('productCountPill').innerText = cards.length + ' Products';
    });
  </script>
</body>
</html>
{% schema %}
{
  "name": "Semi-Custom Sets Catalog",
  "settings": []
}
{% endschema %}

