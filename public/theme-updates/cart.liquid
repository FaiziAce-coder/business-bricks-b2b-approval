<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Cart — {{ shop.name }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <style>
    /* ── CART PAGE ── */
    .cart-page {
      max-width: 920px;
      margin: 0 auto;
      padding: 64px 32px;
    }
    .cart-page h1 {
      font-size: 34px;
      font-weight: 900;
      letter-spacing: -0.5px;
      margin-bottom: 36px;
    }
    .cart-empty {
      text-align: center;
      padding: 80px 0;
    }
    .cart-empty-icon {
      font-size: 56px;
      opacity: 0.3;
      margin-bottom: 16px;
    }
    .cart-empty h2 {
      font-size: 22px;
      margin-bottom: 8px;
    }
    .cart-empty a {
      color: #C089F8;
      text-decoration: none;
      font-weight: 600;
    }
    .cart-empty a:hover {
      text-decoration: underline;
    }

    /* ── CART ITEM CARD ── */
    .cart-item {
      display: flex;
      align-items: flex-start;
      gap: 20px;
      background: var(--card-bg, #111120);
      border: 1px solid rgba(139, 47, 224, 0.22);
      border-radius: 14px;
      padding: 20px;
      margin-bottom: 14px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .cart-item:hover {
      border-color: rgba(139, 47, 224, 0.4);
      box-shadow: 0 4px 20px rgba(139, 47, 224, 0.08);
    }

    /* ── ITEM IMAGE & CUSTOM PREVIEW ── */
    .cart-item-img-wrap {
      position: relative;
      width: 84px;
      height: 84px;
      flex-shrink: 0;
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .cart-item-img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      transition: transform 0.2s ease;
    }
    .cart-item-img-wrap:hover .cart-item-img {
      transform: scale(1.05);
    }
    .custom-preview-tag {
      position: absolute;
      bottom: 4px;
      left: 4px;
      background: rgba(139, 47, 224, 0.9);
      backdrop-filter: blur(4px);
      color: #ffffff;
      font-size: 9px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 2px 6px;
      border-radius: 4px;
      line-height: 1.2;
    }

    /* ── ITEM DETAILS ── */
    .cart-item-info {
      flex: 1;
      min-width: 0;
    }
    .cart-item-title-row {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 4px;
    }
    .cart-item-title {
      font-weight: 700;
      font-size: 16px;
      color: #ffffff;
      text-decoration: none;
      line-height: 1.3;
      word-break: break-word;
    }
    .cart-item-title:hover {
      color: #C089F8;
    }
    .cart-edit-design-link {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      font-weight: 600;
      color: #C089F8;
      text-decoration: none;
      background: rgba(192, 137, 248, 0.08);
      border: 1px solid rgba(192, 137, 248, 0.25);
      padding: 3px 8px;
      border-radius: 6px;
      transition: all 0.18s;
    }
    .cart-edit-design-link:hover {
      background: rgba(192, 137, 248, 0.18);
      border-color: #C089F8;
      color: #ffffff;
    }
    .cart-item-variant {
      color: var(--muted, rgba(255, 255, 255, 0.5));
      font-size: 13px;
      margin-bottom: 4px;
    }

    /* ── TIER BADGE ── */
    .cart-item-tier-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(167, 139, 250, 0.12);
      border: 1px solid rgba(167, 139, 250, 0.28);
      color: #C089F8;
      font-size: 11px;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: 6px;
      margin-top: 4px;
    }

    /* ── CUSTOMIZATION SPECIFICATIONS BOX ── */
    .cart-customizations-box {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px 14px;
      margin-top: 10px;
      padding: 8px 14px;
      background: rgba(139, 47, 224, 0.06);
      border: 1px solid rgba(139, 47, 224, 0.16);
      border-radius: 8px;
    }
    .cart-custom-prop {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: rgba(255, 255, 255, 0.9);
      min-width: 0;
    }
    .cart-custom-label {
      font-weight: 600;
      color: #C089F8;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }
    .cart-custom-val {
      font-weight: 500;
      color: #ffffff;
      word-break: break-word;
    }
    .cart-logo-thumb-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(192, 137, 248, 0.3);
      padding: 2px 8px 2px 4px;
      border-radius: 6px;
      transition: all 0.18s;
    }
    .cart-logo-thumb-link:hover {
      background: rgba(192, 137, 248, 0.16);
      border-color: #C089F8;
    }
    .cart-logo-thumb {
      width: 22px;
      height: 22px;
      object-fit: contain;
      border-radius: 3px;
      background: rgba(0, 0, 0, 0.3);
    }
    .cart-logo-view-text {
      font-size: 11px;
      font-weight: 600;
      color: #C089F8;
    }

    /* ── QUANTITY & PRICE ── */
    .cart-item-qty {
      text-align: center;
      flex-shrink: 0;
    }
    .cart-item-qty input {
      width: 72px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 6px;
      color: #ffffff;
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      text-align: center;
      padding: 8px;
      outline: none;
      transition: border-color 0.2s;
    }
    .cart-item-qty input:focus {
      border-color: rgba(139, 47, 224, 0.55);
    }
    .cart-moq-note {
      display: block;
      margin-top: 4px;
      font-size: 11px;
      color: var(--muted, rgba(255, 255, 255, 0.5));
    }
    .cart-item-price {
      font-weight: 700;
      color: #C089F8;
      font-size: 16px;
      min-width: 105px;
      text-align: right;
      flex-shrink: 0;
    }
    .cart-item-remove {
      color: var(--muted, rgba(255, 255, 255, 0.5));
      text-decoration: none;
      font-size: 20px;
      padding: 0 8px;
      transition: color 0.2s;
      flex-shrink: 0;
    }
    .cart-item-remove:hover {
      color: #F87171;
    }

    /* ── FOOTER & ACTIONS ── */
    .cart-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 36px;
      padding-top: 24px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      flex-wrap: wrap;
      gap: 20px;
    }
    .cart-total {
      font-size: 20px;
      font-weight: 800;
    }
    .cart-total span {
      color: #C089F8;
    }
    .checkout-btn {
      background: var(--purple-g, linear-gradient(135deg, #9B3FEF, #7B28CC));
      color: #ffffff;
      font-family: 'Inter', sans-serif;
      font-size: 16px;
      font-weight: 700;
      padding: 16px 36px;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      box-shadow: 0 4px 18px rgba(139, 47, 224, 0.38);
      transition: opacity 0.2s, transform 0.15s;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .checkout-btn:hover {
      opacity: 0.92;
      transform: translateY(-1px);
    }
    .continue-shopping {
      color: var(--muted, rgba(255, 255, 255, 0.5));
      font-weight: 600;
      text-decoration: none;
      font-size: 14px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 16px;
      transition: color 0.2s;
    }
    .continue-shopping:hover {
      color: #C089F8;
    }

    /* B2B Cart Restriction Banner */
    .cart-b2b-restriction-banner {
      width: 100%;
      background: rgba(139, 47, 224, 0.08);
      border: 1px solid rgba(139, 47, 224, 0.35);
      border-radius: 12px;
      padding: 18px 24px;
      margin-top: 24px;
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .b2b-cart-icon {
      font-size: 26px;
      flex-shrink: 0;
    }
    .b2b-cart-content h4 {
      font-size: 15px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 4px;
    }
    .b2b-cart-content p {
      font-size: 13px;
      color: var(--muted, rgba(255, 255, 255, 0.7));
      margin-bottom: 12px;
    }
    .b2b-cart-buttons {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }
    .b2b-cart-btn {
      display: inline-block;
      background: var(--purple-g, linear-gradient(135deg, #9B3FEF, #7B28CC));
      color: #fff;
      font-size: 13px;
      font-weight: 600;
      padding: 8px 16px;
      border-radius: 8px;
      text-decoration: none;
      transition: opacity 0.2s;
    }
    .b2b-cart-btn:hover { opacity: 0.9; }
    .b2b-cart-link {
      font-size: 13px;
      font-weight: 600;
      color: #C089F8;
      text-decoration: none;
    }
    .b2b-cart-link:hover { text-decoration: underline; }

    /* ── RESPONSIVE ADAPTATION ── */
    @media (max-width: 768px) {
      .cart-page {
        padding: 36px 16px;
      }
      .cart-page h1 {
        font-size: 26px;
        margin-bottom: 24px;
      }
      .cart-item {
        position: relative;
        flex-wrap: wrap;
        gap: 14px;
        padding: 16px;
      }
      .cart-item-img-wrap {
        width: 68px;
        height: 68px;
      }
      .cart-item-info {
        flex: 1 1 calc(100% - 110px);
        min-width: 0;
      }
      .cart-item-remove {
        position: absolute;
        top: 14px;
        right: 14px;
        padding: 4px 8px;
        font-size: 18px;
      }
      .cart-customizations-box {
        flex-basis: 100%;
        margin-top: 6px;
      }
      .cart-item-qty {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 6px;
      }
      .cart-moq-note {
        margin-top: 0;
      }
      .cart-item-price {
        text-align: right;
        margin-left: auto;
        margin-top: 6px;
      }
      .cart-footer {
        flex-direction: column;
        align-items: stretch;
        gap: 16px;
      }
      .cart-total {
        text-align: right;
      }
      .checkout-btn {
        width: 100%;
        justify-content: center;
      }
    }
    @media (max-width: 480px) {
      .cart-item-title {
        font-size: 15px;
      }
      .cart-item-info {
        flex: 1 1 calc(100% - 100px);
      }
      .cart-edit-design-link {
        margin-top: 2px;
      }
    }
  </style>
  {{ content_for_header }}
</head>
<body>
<div class="page">

  <!-- CART CONTENT -->
  <div class="cart-page">
    <h1>Your Cart</h1>

    {% if cart.item_count > 0 %}
      <form action="/cart" method="post">
        {% for item in cart.items %}
          {%- assign item_image_src = item.image | img_url: '160x' -%}
          {%- assign has_custom_preview = false -%}
          {%- if item.properties['_cm-thumb-url'] != blank and item.properties['_cm-thumb-url'] != 'null' -%}
            {%- assign item_image_src = item.properties['_cm-thumb-url'] -%}
            {%- assign has_custom_preview = true -%}
          {%- elsif item.properties['customix_preview'] != blank -%}
            {%- assign item_image_src = item.properties['customix_preview'] -%}
            {%- assign has_custom_preview = true -%}
          {%- endif -%}

          <div class="cart-item">
            <div class="cart-item-img-wrap">
              <img src="{{ item_image_src }}" alt="{{ item.title | escape }}" class="cart-item-img" loading="lazy" />
              {%- if has_custom_preview -%}
                <span class="custom-preview-tag" title="Customized 3D Design">Custom</span>
              {%- endif -%}
            </div>

            <div class="cart-item-info">
              <div class="cart-item-title-row">
                <a href="{{ item.url }}" class="cart-item-title">{{ item.product.title }}</a>
                {%- if item.properties['_cm-customization-url'] != blank and item.properties['_cm-customization-url'] != 'null' -%}
                  <a href="{{ item.properties['_cm-customization-url'] }}" class="cart-edit-design-link" title="Re-open 3D customizer">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    Edit Design
                  </a>
                {%- endif -%}
              </div>

              {%- unless item.product.has_only_default_variant or item.variant.title == 'Default Title' -%}
                <div class="cart-item-variant">{{ item.variant.title }}</div>
              {%- endunless -%}

              {%- if item.properties['Volume Pricing Tier'] != blank -%}
                <div class="cart-item-tier-badge">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                  <span>{{ item.properties['Volume Pricing Tier'] }}</span>
                </div>
              {%- endif -%}

              {%- assign visible_props_count = 0 -%}
              {%- for p in item.properties -%}
                {%- assign p_first_char = p.first | slice: 0 -%}
                {%- assign p_first_down = p.first | downcase -%}
                {%- assign p_val_down = p.last | downcase -%}

                {%- if p_first_char == '_' -%}{%- continue -%}{%- endif -%}
                {%- if p.last == blank or p_val_down == 'null' or p_val_down == 'undefined' -%}{%- continue -%}{%- endif -%}
                {%- if p.first == 'Volume Pricing Tier' or p.first == 'Tier Unit Price' or p.first == 'Estimated Subtotal' -%}{%- continue -%}{%- endif -%}
                {%- if p_first_down contains 'customix' or p_first_down contains 'customization' or p_first_down contains 'print_file' or p_first_down contains 'print-file' or p_first_down contains 'origin-image' or p_first_down contains 'thumb-url' -%}{%- continue -%}{%- endif -%}
                {%- assign visible_props_count = visible_props_count | plus: 1 -%}
              {%- endfor -%}

              {%- if visible_props_count > 0 -%}
                <div class="cart-customizations-box">
                  {%- for p in item.properties -%}
                    {%- assign p_first_char = p.first | slice: 0 -%}
                    {%- assign p_first_down = p.first | downcase -%}
                    {%- assign p_val_down = p.last | downcase -%}

                    {%- if p_first_char == '_' -%}{%- continue -%}{%- endif -%}
                    {%- if p.last == blank or p_val_down == 'null' or p_val_down == 'undefined' -%}{%- continue -%}{%- endif -%}
                    {%- if p.first == 'Volume Pricing Tier' or p.first == 'Tier Unit Price' or p.first == 'Estimated Subtotal' -%}{%- continue -%}{%- endif -%}
                    {%- if p_first_down contains 'customix' or p_first_down contains 'customization' or p_first_down contains 'print_file' or p_first_down contains 'print-file' or p_first_down contains 'origin-image' or p_first_down contains 'thumb-url' -%}{%- continue -%}{%- endif -%}

                    {%- assign prop_label = p.first -%}
                    {%- if prop_label == 'Enter your text (Optional)' or prop_label == 'Custom Text' -%}
                      {%- assign prop_label = 'Text' -%}
                    {%- elsif prop_label == 'Upload your logo' or prop_label == 'Your Logo' -%}
                      {%- assign prop_label = 'Logo' -%}
                    {%- endif -%}

                    <div class="cart-custom-prop">
                      <span class="cart-custom-label">{{ prop_label }}:</span>
                      {%- if p.last contains 'http://' or p.last contains 'https://' -%}
                        {%- if p.last contains '.png' or p.last contains '.jpg' or p.last contains '.jpeg' or p.last contains '.svg' or p.last contains '.webp' or p_first_down contains 'logo' or p_first_down contains 'image' -%}
                          <a href="{{ p.last }}" target="_blank" rel="noopener noreferrer" class="cart-logo-thumb-link" title="Open full uploaded asset">
                            <img src="{{ p.last }}" alt="{{ prop_label | escape }}" class="cart-logo-thumb" loading="lazy" />
                            <span class="cart-logo-view-text">View Logo ↗</span>
                          </a>
                        {%- else -%}
                          <a href="{{ p.last }}" target="_blank" rel="noopener noreferrer" class="cart-custom-val" style="color:#C089F8;text-decoration:underline;">View Attachment ↗</a>
                        {%- endif -%}
                      {%- else -%}
                        <span class="cart-custom-val">{{ p.last }}</span>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
            
            <!-- CART QUANTITY SECTION -->
            <div class="cart-item-qty">
              {% assign cart_minimum_order = item.product.metafields.custom.minimum_order %}
              <input
                type="number"
                name="updates[{{ item.key }}]"
                value="{{ item.quantity }}"
                {% if cart_minimum_order != blank %}
                  min="{{ cart_minimum_order }}"
                {% else %}
                  min="1"
                {% endif %}
                step="1"
              />
              {% if cart_minimum_order != blank %}
                <small class="cart-moq-note">
                  MOQ: {{ cart_minimum_order }} Units
                </small>
              {% endif %}
            </div>

            <div class="cart-item-price">
              {%- if item.variant.title != 'Default Title' and item.variant.title != blank -%}
                <span style="display:block;font-size:16px;font-weight:800;color:#C089F8;">{{ item.final_price | money }} <span style="font-size:11px;font-weight:400;color:var(--muted);">/ unit</span></span>
                <span style="display:block;font-size:12px;color:rgba(255,255,255,0.7);margin-top:2px;">Total: {{ item.final_line_price | money }}</span>
              {%- elsif item.properties['_Tier Unit Price'] != blank or item.properties['Tier Unit Price'] != blank -%}
                <span style="display:block;font-size:16px;font-weight:800;color:#C089F8;">{{ item.final_price | money }} <span style="font-size:11px;font-weight:400;color:var(--muted);">/ unit</span></span>
                <span style="display:block;font-size:12px;color:rgba(255,255,255,0.7);margin-top:2px;">Total: {{ item.final_line_price | money }}</span>
              {%- else -%}
                {{ item.final_price | money }}
              {%- endif -%}
            </div>
            
            <a href="/cart/change?line={{ forloop.index }}&quantity=0" class="cart-item-remove" title="Remove item">✕</a>
          </div>
        {% endfor %}

        {%- assign has_semi_custom_items = false -%}
        {%- for cart_item in cart.items -%}
          {%- if cart_item.product.template_suffix == 'semi-custom-sets' or cart_item.product.tags contains 'semi-custom' -%}
            {%- assign has_semi_custom_items = true -%}
          {%- endif -%}
        {%- endfor -%}

        {%- assign is_b2b_approved = false -%}
        {%- if customer and customer.tags contains 'b2b-approved' -%}
          {%- assign is_b2b_approved = true -%}
        {%- endif -%}

        {%- if has_semi_custom_items and is_b2b_approved == false -%}
          <div class="cart-b2b-restriction-banner">
            <div class="b2b-cart-icon">🔒</div>
            <div class="b2b-cart-content">
              <h4>Wholesale Approval Required</h4>
              <p>Your cart contains semi-custom products that require an approved wholesale account to purchase.</p>
              <div class="b2b-cart-buttons">
                {%- if customer and customer.tags contains 'b2b-pending' -%}
                  <a href="/pages/contact" class="b2b-cart-btn">Check Application Status</a>
                {%- else -%}
                  <a href="/pages/wholesale-signup" class="b2b-cart-btn">Apply for Wholesale Access</a>
                  {%- unless customer -%}
                    <a href="/account/login?return_to=/cart" class="b2b-cart-link">Already Approved? Sign In →</a>
                  {%- endunless -%}
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}

        <div class="cart-footer">
          {%- assign has_tier_pricing = false -%}
          {%- for cart_item in cart.items -%}
            {%- if cart_item.properties['_Tier Unit Price'] != blank or cart_item.properties['Tier Unit Price'] != blank or cart_item.variant.title != 'Default Title' -%}
              {%- assign has_tier_pricing = true -%}
            {%- endif -%}
          {%- endfor -%}

          <div class="cart-total">
            Subtotal: <span>{{ cart.total_price | money }}</span>
            {%- if has_tier_pricing -%}
              <div style="font-size:11px;font-weight:500;color:#A78BFA;margin-top:4px;">Volume Tier Pricing Applied</div>
            {%- endif -%}
          </div>
          {%- if has_semi_custom_items and is_b2b_approved == false -%}
            <button type="button" class="checkout-btn b2b-disabled" disabled style="opacity: 0.55; cursor: not-allowed; background: #262630; border: 1px solid rgba(255,255,255,0.15); box-shadow: none;">
              🔒 Wholesale Approval Required to Checkout
            </button>
          {%- else -%}
            <button type="submit" name="checkout" class="checkout-btn">
              Proceed to Checkout
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M8 4l4 4-4 4" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          {%- endif -%}
        </div>
      </form>

      <a href="/pages/catalog" class="continue-shopping">
        ← Continue Shopping
      </a>
    {% else %}
      <div class="cart-empty">
        <div class="cart-empty-icon">🛒</div>
        <h2>Your cart is empty</h2>
        <p style="color:var(--muted);margin-bottom:16px;">Looks like you haven’t added anything yet.</p>
        <a href="/pages/catalog">← Back to catalog</a>
      </div>
    {% endif %}
  </div>

</div><!-- /page -->
<!-- MOQ VALIDATION SCRIPT -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  const qtyInputs = document.querySelectorAll('input[type="number"]');

  qtyInputs.forEach(function(input) {
    const min = parseInt(input.getAttribute('min')) || 1;

    input.addEventListener('blur', function() {
      let value = parseInt(input.value);
      if (!value || value < min) {
        input.value = min;
      }
    });

    input.addEventListener('change', function() {
      let value = parseInt(input.value);
      if (!value || value < min) {
        input.value = min;
      }
    });
  });
});
</script>
<script>
  window.BB_CUSTOMER_ID = {{ customer.id | json }};
  window.BB_CUSTOMER_EMAIL = {{ customer.email | json }};
  window.BB_CUSTOMER_APPROVED = {{ is_b2b_approved | json }};
  window.BB_HAS_SEMI_CUSTOM_CART = {{ has_semi_custom_items | json }};
  window.BB_API_BASE_URL = 'https://business-bricks-customer-approval.onrender.com';
</script>
<script src="{{ 'b2b-approval-gate.js' | asset_url }}" defer></script>
</body>
</html>
