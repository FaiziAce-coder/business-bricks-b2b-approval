    <script>
      (function () {
        const modal = document.getElementById('b2bWholesaleModal');
        if (!modal) return;

        const closeBtn = document.getElementById('b2bModalCloseBtn');
        const doneBtn = document.getElementById('modalDoneBtn');
        const form = document.getElementById('modalWholesaleForm');
        const successView = document.getElementById('modalSuccessView');
        const submitBtn = document.getElementById('modalSubmitBtn');
        const alertEl = document.getElementById('modalGeneralAlert');
        const refPill = document.getElementById('modalRefPill');

        function openModal() {
          modal.classList.add('active');
          modal.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }

        function closeModal() {
          modal.classList.remove('active');
          modal.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }

        // Intercept any click on "Apply for Wholesale Access" button or .open-wholesale-modal-btn
        document.addEventListener('click', function (e) {
          const trigger = e.target.closest('.open-wholesale-modal-btn, .b2b-access-btn');
          if (trigger && (trigger.getAttribute('href') === '/pages/wholesale-signup' || trigger.classList.contains('open-wholesale-modal-btn'))) {
            e.preventDefault();
            openModal();
          }
        });

        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (doneBtn) doneBtn.addEventListener('click', closeModal);

        modal.addEventListener('click', function (e) {
          if (e.target === modal) {
            closeModal();
          }
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && modal.classList.contains('active')) {
            closeModal();
          }
        });

        function clearErrors() {
          if (alertEl) {
            alertEl.style.display = 'none';
            alertEl.textContent = '';
            alertEl.className = 'b2b-modal-alert';
          }
          modal.querySelectorAll('.has-error').forEach(function (el) { el.classList.remove('has-error'); });
          modal.querySelectorAll('.b2b-field-err').forEach(function (el) { el.style.display = 'none'; });
        }

        function showFieldError(inputId, errId) {
          const input = document.getElementById(inputId);
          const err = document.getElementById(errId);
          if (input) input.classList.add('has-error');
          if (err) err.style.display = 'block';
        }

        if (form) {
          form.addEventListener('submit', async function (e) {
            e.preventDefault();
            clearErrors();

            const firstName = (document.getElementById('mFirstName')?.value || '').trim();
            const lastName = (document.getElementById('mLastName')?.value || '').trim();
            const email = (document.getElementById('mEmail')?.value || '').trim();
            const company = (document.getElementById('mCompany')?.value || '').trim();
            const phone = (document.getElementById('mPhone')?.value || '').trim();
            const businessType = document.getElementById('mBusinessType')?.value || '';
            const address1 = (document.getElementById('mAddress1')?.value || '').trim();
            const address2 = (document.getElementById('mAddress2')?.value || '').trim();
            const city = (document.getElementById('mCity')?.value || '').trim();
            const province = (document.getElementById('mProvince')?.value || '').trim();
            const zip = (document.getElementById('mZip')?.value || '').trim();
            const country = document.getElementById('mCountry')?.value || 'United States';
            const taxId = (document.getElementById('mTaxId')?.value || '').trim();
            const website = (document.getElementById('mWebsite')?.value || '').trim();
            const asiNumber = (document.getElementById('mAsiNumber')?.value || '').trim();
            const sageNumber = (document.getElementById('mSageNumber')?.value || '').trim();
            const ppaiNumber = (document.getElementById('mPpaiNumber')?.value || '').trim();
            const estimatedVolume = document.getElementById('mEstimatedVolume')?.value || '';
            const howHeard = document.getElementById('mHowHeard')?.value || '';
            const reasonForApplying = (document.getElementById('mReasonForApplying')?.value || '').trim();

            let hasError = false;
            if (!firstName) { showFieldError('mFirstName', 'mFirstNameErr'); hasError = true; }
            if (!lastName) { showFieldError('mLastName', 'mLastNameErr'); hasError = true; }
            if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showFieldError('mEmail', 'mEmailErr'); hasError = true; }
            if (!company) { showFieldError('mCompany', 'mCompanyErr'); hasError = true; }
            if (!phone || phone.length < 7) { showFieldError('mPhone', 'mPhoneErr'); hasError = true; }
            if (!businessType) { showFieldError('mBusinessType', 'mBusinessTypeErr'); hasError = true; }
            if (!address1) { showFieldError('mAddress1', 'mAddress1Err'); hasError = true; }
            if (!city) { showFieldError('mCity', 'mCityErr'); hasError = true; }
            if (!zip) { showFieldError('mZip', 'mZipErr'); hasError = true; }
            if (!country) { showFieldError('mCountry', 'mCountryErr'); hasError = true; }
            if (!howHeard) { showFieldError('mHowHeard', 'mHowHeardErr'); hasError = true; }

            if (hasError) return;

            submitBtn.disabled = true;
            const originalBtnText = submitBtn.innerHTML;
            submitBtn.innerHTML = '<span>Submitting Application...</span>';

            const payload = {
              firstName,
              lastName,
              email,
              company,
              phone,
              businessType,
              address1,
              address2: address2 || null,
              city,
              province: province || null,
              zip,
              country,
              taxId: taxId || null,
              website: website || null,
              asiNumber: asiNumber || null,
              sageNumber: sageNumber || null,
              ppaiNumber: ppaiNumber || null,
              howHeard: howHeard || null,
              estimatedVolume: estimatedVolume || null,
              reasonForApplying: reasonForApplying || null,
              shopifyCustomerId: window.BB_CUSTOMER_ID || null,
              isEmailPreVerified: Boolean(window.BB_CUSTOMER_ID)
            };

            try {
              const res = await fetch('https://business-bricks-customer-approval.onrender.com/api/applications', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
              });

              const data = await res.json();

              if (!res.ok) {
                throw new Error(data.error || 'Submission failed. Please check your information and try again.');
              }

              const refNum = data.referenceNumber || 'BB-APP-xxxx';
              if (refPill) refPill.textContent = refNum;

              // Hide form, show success
              form.style.display = 'none';
              if (successView) successView.style.display = 'block';

              // Update the card on the page dynamically
              const cardContainer = document.getElementById('b2bAccessCardContainer');
              if (cardContainer) {
                cardContainer.innerHTML = `
                  <div class="b2b-access-card b2b-pending-state" data-b2b-state="pending">
                    <div class="b2b-access-badge">⏳ Under Review</div>
                    <h3>Wholesale Application Under Review</h3>
                    <p>Your wholesale application (${refNum}) is currently under review by our team. Direct purchasing access will be unlocked once approved.</p>
                    <a href="/pages/contact" class="b2b-access-sublink">Questions or custom requests? Contact us →</a>
                  </div>
                `;
              }
            } catch (err) {
              if (alertEl) {
                alertEl.textContent = err.message;
                alertEl.className = 'b2b-modal-alert error';
                alertEl.style.display = 'block';
              }
            } finally {
              submitBtn.disabled = false;
              submitBtn.innerHTML = originalBtnText;
            }
          });
        }
      })();
    </script>
  </body>
</html>
